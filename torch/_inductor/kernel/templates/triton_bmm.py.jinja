{{def_kernel("A", "B")}}
    M = {{size("A", -2)}}
    N = {{size("B", -1)}}
    K = {{size("A", -1)}}
    BATCH = {{size("A", 0)}}

    stride_aq = {{stride("A", 0)}}
    stride_am = {{stride("A", 1)}}
    stride_ak = {{stride("A", 2)}}

    stride_bq = {{stride("B", 0)}}
    stride_bk = {{stride("B", 1)}}
    stride_bn = {{stride("B", 2)}}

    # based on triton.ops.matmul
    pid = tl.program_id(0).to(INDEX_DTYPE)
{%- set SWAP = SWAP_AB|default(false) %}
{%- if SWAP %}
    # SWAP_AB computes C^T = B^T @ A^T: BLOCK_M tiles N and BLOCK_N tiles M
    grid_m = (N + BLOCK_M - 1) // BLOCK_M
    grid_n = (M + BLOCK_N - 1) // BLOCK_N
{%- else %}
    grid_m = (M + BLOCK_M - 1) // BLOCK_M
    grid_n = (N + BLOCK_N - 1) // BLOCK_N
{%- endif %}

    # re-order program ID for better L2 performance
    width = GROUP_M * grid_n
    group_id = pid // width
    group_size = min(grid_m - group_id * GROUP_M, GROUP_M)
    pid_m = group_id * GROUP_M + (pid % group_size)
    pid_n = (pid % width) // (group_size)
    tl.assume(pid_m >= 0)
    tl.assume(pid_n >= 0)

    rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M).to(INDEX_DTYPE)
    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N).to(INDEX_DTYPE)
{%- set RA, BLOCK_A, RB, BLOCK_B = ("rn", "BLOCK_N", "rm", "BLOCK_M") if SWAP else ("rm", "BLOCK_M", "rn", "BLOCK_N") %}
    if ((stride_am == 1 and stride_ak == M) or (stride_am == K and stride_ak == 1)) and (M >= {{BLOCK_A}} and K > 1):
        ram = tl.max_contiguous(tl.multiple_of({{RA}} % M, {{BLOCK_A}}), {{BLOCK_A}})
    else:
        ram = {{RA}} % M
    if ((stride_bk == 1 and stride_bn == K) or (stride_bk == N and stride_bn == 1)) and (N >= {{BLOCK_B}} and K > 1):
        rbn = tl.max_contiguous(tl.multiple_of({{RB}} % N, {{BLOCK_B}}), {{BLOCK_B}})
    else:
        rbn = {{RB}} % N

    rk = tl.arange(0, BLOCK_K).to(INDEX_DTYPE)

    # Reconstruct batch index from grid_y/grid_z split (handles batch > 65535)
    idx_q = (tl.program_id(1) + tl.program_id(2) * tl.num_programs(1)).to(INDEX_DTYPE)
    # Clamp to valid range for safe pointer arithmetic; out-of-bounds CTAs are
    # masked off at the store below.
    idx_q_clamped = tl.minimum(idx_q, BATCH - 1)
{%- if SWAP %}
    # A points at the A^T tile and B at the B^T tile
    A = A + (ram[None, :] * stride_am + rk[:, None] * stride_ak + idx_q_clamped*stride_aq)
    B = B + (rk[None, :] * stride_bk + rbn[:, None] * stride_bn + idx_q_clamped*stride_bq)
{%- else %}
    A = A + (ram[:, None] * stride_am + rk[None, :] * stride_ak + idx_q_clamped*stride_aq)
    B = B + (rk[:, None] * stride_bk + rbn[None, :] * stride_bn + idx_q_clamped*stride_bq)
{%- endif %}

    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=ACC_TYPE)
    {% if ASCENDING_K|default(false) %}
    # XPU renders the K loop ascending (see MMTemplateConfigMixin.ascending_k).
    for k_idx in range(0, tl.cdiv(K, BLOCK_K)):
        k_remaining = K - k_idx * BLOCK_K
    {% else %}
    for k_remaining in range(K, 0, -BLOCK_K):
    {% endif %}
        if EVEN_K:
            a = tl.load(A)
            b = tl.load(B)
        else:
{%- if SWAP %}
            a = tl.load(A, mask=rk[:, None] < k_remaining, other=0.)
            b = tl.load(B, mask=rk[None, :] < k_remaining, other=0.)
        acc += tl.dot(b, a, allow_tf32=ALLOW_TF32)
{%- else %}
            a = tl.load(A, mask=rk[None, :] < k_remaining, other=0.)
            b = tl.load(B, mask=rk[:, None] < k_remaining, other=0.)
        acc += tl.dot(a, b, allow_tf32=ALLOW_TF32)
{%- endif %}
        A += BLOCK_K * stride_ak
        B += BLOCK_K * stride_bk

    # rematerialize rm and rn to save registers
    rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M).to(INDEX_DTYPE)
    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N).to(INDEX_DTYPE)
    idx_q = (tl.program_id(1) + tl.program_id(2) * tl.num_programs(1)).to(INDEX_DTYPE)
{%- if SWAP %}
    idx_m = rn[None, :]
    idx_n = rm[:, None]
{%- else %}
    idx_m = rm[:, None]
    idx_n = rn[None, :]
{%- endif %}
    mask = (idx_m < M) & (idx_n < N) & (idx_q < BATCH)

    # inductor generates a suffix
    {{store_output(("idx_q", "idx_m", "idx_n"), "acc", "mask", val_shape=("BLOCK_M", "BLOCK_N"))}}
